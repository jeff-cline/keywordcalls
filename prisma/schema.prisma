// keywordcalls.com — standalone app, isolated DB (SQLite dev / Postgres prod on the Core box).
// JSON stored as String for sqlite<->postgres parity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Everyone who logs in: God, Manager, Rep (org tiers), and Customer.
model Account {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("customer") // god | vp | regional | manager | rep | customer
  firstName          String    @default("")
  lastName           String    @default("")
  phone              String    @default("")
  city               String    @default("")
  state              String    @default("")
  zip                String    @default("")
  mustChangePassword Boolean   @default(false)
  active             Boolean   @default(true)
  parentId           String? // who they report to (org / affiliate tree)
  refSlug            String    @unique @default("") // firstname-lastname tracking link
  createdAt          DateTime  @default(now())
  customer           Customer?

  @@index([role])
  @@index([parentId])
}

// Customer campaign configuration (1:1 with a customer Account).
model Customer {
  id              String    @id @default(cuid())
  accountId       String    @unique
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  keywords        String    @default("[]") // JSON string[] of keyword ids/names
  geoType         String    @default("local") // local | statewide | regional | national
  geoStates       String    @default("[]") // JSON 2-letter codes (statewide=1, regional<=3)
  geoZips         String    @default("[]") // JSON ZIP codes (local accounts route by ZIP)
  geoExcludeStates String   @default("[]") // JSON 2-letter codes to EXCLUDE (national accounts)
  hours           String    @default("{}") // JSON { days:[], start:"09:00", end:"17:00" }
  routingNumber   String    @default("") // where their calls go (E.164)
  planId          String    @default("")
  balanceCents    Int       @default(0) // pre-funded balance
  agreementSignedAt DateTime?
  freeCallUsed    Boolean   @default(false)
  twilioNumber    String    @default("") // provisioned tracking number (E.164)
  twilioNumberSid String    @default("") // Twilio IncomingPhoneNumber SID (for release)
  areaCode        String    @default("") // desired area code (from phone/zip)
  bidsJson        String    @default("{}") // JSON { keyword: bidCents } — what they'll pay per call
  status          String    @default("new") // new | funded | live | paused
  referredBy      String? // ref account id (affiliate attribution)
  ltvCents        Int       @default(0) // customer lifetime value (from Get Results / results page)
  resultsToken    String    @default("") // token for their branded results page + PDF
  autoTopUp       Boolean   @default(false) // auto-charge saved card when low
  autoTopUpAmountCents Int  @default(0) // how much to add on auto-top-up
  lowBalanceNotifiedAt DateTime? // last "running low" email (reset on top-up)
  stripeCustomerId String   @default("") // for saved-card off-session top-ups
  createdAt       DateTime  @default(now())

  calls           Call[]
}

// One inbound call delivered to a customer's tracking number.
model Call {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  callSid      String    @unique @default("")
  fromNumber   String    @default("") // the consumer who called
  toNumber     String    @default("") // the customer's tracking number
  keyword      String    @default("")
  status       String    @default("initiated") // initiated | in-progress | completed | no-answer | busy | failed | rejected
  durationSec  Int       @default(0)
  connectSec   Int       @default(0) // buyer-leg talk time (billing clock)
  chargedCents Int       @default(0) // charged to the customer's balance (their bid)
  costCents    Int       @default(0) // our Twilio cost
  billed       Boolean   @default(false)
  recordingUrl String    @default("")
  appended     String    @default("{}") // JSON: Core data-append on the caller (God-only)
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@map("call")
}

// Every email we send (for COGS + audit). COGS per email is a Setting (emailCogsCents).
model EmailLog {
  id        String   @id @default(cuid())
  to        String   @default("")
  subject   String   @default("")
  kind      String   @default("") // low_balance | campaign | receipt | other
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("email_log")
}

// An uploaded list of people to call/email (reusable across campaigns). Timestamped.
model CallList {
  id        String   @id @default(cuid())
  name      String   @default("")
  source    String   @default("") // original filename
  rowCount  Int      @default(0)
  createdAt DateTime @default(now())
  contacts  ListContact[]
  campaigns OutreachCampaign[]
  @@map("call_list")
}

model ListContact {
  id        String   @id @default(cuid())
  listId    String
  list      CallList @relation(fields: [listId], references: [id], onDelete: Cascade)
  firstName String   @default("")
  lastName  String   @default("")
  phone     String   @default("") // primary E.164
  altPhones String   @default("[]") // JSON extra numbers
  email     String   @default("")
  city      String   @default("")
  state     String   @default("")
  zip       String   @default("")
  createdAt DateTime @default(now())
  @@index([listId])
  @@index([listId, state])
  @@map("list_contact")
}

// An outbound calling/voice-drop campaign the God builds from a list.
model OutreachCampaign {
  id                String    @id @default(cuid())
  name              String    @default("")
  listId            String?
  list              CallList? @relation(fields: [listId], references: [id])
  states            String    @default("[]") // JSON filter of 2-letter states
  bidCents          Int       @default(0) // what a delivered call is worth
  hoursStart        String    @default("08:30")
  hoursEnd          String    @default("17:00")
  tz                String    @default("America/New_York")
  status            String    @default("off") // off | on
  mode              String    @default("voice_email") // voice_email | voice_only | email_only
  emailDelayMin     Int       @default(5) // minutes after the email before the voice drop
  callsPerMin       Int       @default(30) // voicemail-drop throttle for this campaign
  outboundAudioUrl  String    @default("") // played to the voicemail machine
  followupAudioUrl  String    @default("") // next-day follow-up voicemail
  afterHoursAudioUrl String   @default("") // "sorry we missed you, call us back" — live recovery + 10am re-drop
  afterHoursJdiWav  String    @default("") // afterHoursAudioUrl uploaded into JDI's library
  afterHoursMessage String    @default("Sorry, we're closed. Can we follow up with you during normal business hours?")
  followupMessage   String    @default("I tried to follow up with you earlier. Please give me a call back.")
  emailSubject      String    @default("")
  emailBody         String    @default("")
  routingNumber     String    @default("") // where callbacks route — the campaign owner / call center (E.164)
  dialedCount       Int       @default(0)
  connectedCount    Int       @default(0) // callbacks received
  deliveredCount    Int       @default(0) // ringless voicemails actually delivered (from JDI)
  filteredCount     Int       @default(0) // scrubbed by DNC / carrier filters (from JDI)
  revenueCents      Int       @default(0)
  campaignNumber    String    @default("") // this campaign's own caller-ID / callback number (Twilio)
  campaignNumberSid String    @default("")
  cursor            String    @default("") // last processed ListContact id (paced runner)
  rolloutCursor     String    @default("") // last ListContact id sent via a manual /rollout batch
  rolloutGroup      String    @default("") // A/B/C/D lead-set test group for the /rollout console
  jdiWav            String    @default("") // recording uploaded to JDI (ringless audio URL)
  jdiCampaignIds    String    @default("[]") // JSON array of JDI ringless campaign ids
  jdiDone           Boolean   @default(false) // voice list fully handed to JDI
  emailCursor       String    @default("") // last ListContact id emailed (paced email)
  emailDone         Boolean   @default(false)
  startedAt         DateTime? // when the campaign was last turned on
  finishedAt        DateTime? // when it completed its full list
  createdAt         DateTime  @default(now())
  @@map("outreach_campaign")
}

// One contact worked by a campaign's paced runner (dedup + email→voice scheduling + outcome).
model OutreachCall {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  phone       String    @default("")
  emailSentAt DateTime?
  voiceAt     DateTime? // scheduled voice-drop time (voice follows email by the delay)
  voiceDoneAt DateTime?
  outcome     String    @default("") // vm_left | not_connected
  createdAt   DateTime  @default(now())
  @@unique([campaignId, contactId])
  @@index([campaignId, voiceAt])
  @@map("outreach_call")
}

// Seasoned-number pool. Every number we buy is tracked here, tied to a money word so it can be
// REUSED for that same money word later. In use → locked to a campaign; released → available again
// (we never drop the number from Twilio, so its seasoning is never lost).
model PhoneNumber {
  id             String    @id @default(cuid())
  number         String    @unique // E.164
  sid            String    @default("") // Twilio IncomingPhoneNumber SID
  moneyWord      String    @default("") // the keyword this number is seasoned for
  areaCode       String    @default("")
  status         String    @default("available") // available | in_use
  customerId     String? // customer campaign it's assigned to
  campaignId     String? // outbound campaign it's assigned to
  campaignName   String    @default("") // denormalized for display
  callsIn        Int       @default(0) // calls delivered on this number
  callsMonetized Int       @default(0) // billed calls
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  @@index([moneyWord])
  @@index([status])
  @@map("phone_number")
}

// Every number a rollout batch was sent to — appended up front, flips "green" (calledBack) on callback.
model RolloutTarget {
  id           String    @id @default(cuid())
  campaignId   String
  batchId      String    @default("")
  phone        String    @default("")
  name         String    @default("")
  email        String    @default("")
  city         String    @default("")
  state        String    @default("")
  calledBack   Boolean   @default(false)
  calledBackAt DateTime?
  landedAt     String    @default("") // number the callback was routed to
  connectSec   Int       @default(0)
  billable     Boolean   @default(false)
  at           DateTime  @default(now()) // when it was sent (batch launch)
  @@index([campaignId, calledBack])
  @@index([campaignId, phone])
  @@map("rollout_target")
}

// A manually-launched rollout batch (100 / 500 / 1,000…) for the /rollout experiment console.
model RolloutBatch {
  id            String   @id @default(cuid())
  campaignId    String
  label         String   @default("")
  size          Int      @default(0)
  jdiCampaignId String   @default("")
  throttle      Int      @default(0)
  launchedAt    DateTime @default(now())
  @@index([campaignId, launchedAt])
  @@map("rollout_batch")
}

// Every callback into a campaign's number — timestamped + appended, with the connected-leg talk time
// (the transferred leg after the owner answers). Billable at 120s+. Powers the rollout time-series.
model CampaignCallback {
  id         String   @id @default(cuid())
  campaignId String
  phone      String   @default("") // the consumer who called back
  name       String   @default("")
  email      String   @default("")
  city       String   @default("")
  state      String   @default("")
  landedAt   String   @default("") // the number the call was routed to (campaign owner)
  connectSec Int      @default(0)  // seconds connected on the transferred leg
  billable   Boolean  @default(false) // connectSec >= 120
  outcome    String   @default("") // connected | after_hours | no_answer | abandoned
  redropped  Boolean  @default(false) // a 10am recovery voicemail was sent to this lead
  redroppedAt DateTime?
  at         DateTime @default(now())
  @@index([campaignId, at])
  @@index([outcome, redropped])
  @@map("campaign_callback")
}

// Persistent record of everyone we've demoed the system to (numbers dropped from /demo) + append.
model DemoContact {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String   @default("")
  email        String   @default("")
  city         String   @default("")
  state        String   @default("")
  zip          String   @default("")
  appended     String   @default("{}") // extra appended fields (JSON)
  timesDemoed  Int      @default(1)
  lastDemoedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([lastDemoedAt])
  @@map("demo_contact")
}

// Live-demo activity feed (voicemails left + real callbacks) for trade-show demos.
model DemoEvent {
  id        String   @id @default(cuid())
  kind      String   @default("drop") // drop | callback
  phone     String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("demo_event")
}

// Monthly plans (editable prices).
model Plan {
  id          String   @id @default(cuid())
  name        String
  scope       String   @default("local") // local | statewide | regional | national
  priceCents  Int      @default(0)
  multiAgent  Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  @@map("plan")
}

// Keyword catalog + per-call price (the bid floor). e.g. health insurance $90.
model Keyword {
  id         String   @id @default(cuid())
  name       String   @unique
  priceCents Int      @default(0) // per-call price
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)

  @@map("keyword")
}

// Footer contact forms: press / investor / partnership / advertise / sponsor.
model ContactLead {
  id        String   @id @default(cuid())
  kind      String   @default("contact") // press | investor | partnership | advertise | sponsor | contact
  name      String   @default("")
  phone     String   @default("")
  email     String   @default("")
  company   String   @default("")
  website   String   @default("")
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@map("contact_lead")
}

// Every money movement on a customer's pre-funded balance.
model LedgerEntry {
  id              String   @id @default(cuid())
  customerId      String
  kind            String   @default("fund") // fund | charge | coupon | adjustment | refund
  amountCents     Int      @default(0) // + credit, - debit
  balanceAfterCents Int    @default(0)
  note            String   @default("")
  stripeRef       String   @default("") // checkout session / payment intent id
  createdAt       DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("ledger_entry")
}

// Coupon codes: a percent discount on a funding amount, OR free funds added to the balance.
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           String    @default("percent") // percent | add_funds
  value          Int       @default(0) // percent (0-100) OR cents to add
  active         Boolean   @default(true)
  maxRedemptions Int       @default(0) // 0 = unlimited
  redeemed       Int       @default(0)
  expiresAt      DateTime?
  note           String    @default("")
  createdAt      DateTime  @default(now())

  @@map("coupon")
}

// God-editable knobs (setup fee, min fund, calendly url, etc.).
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("setting")
}
